generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum RoleType {
  SUPER_ADMIN_PDHS
  ADMIN_PDHS
  SUPER_ADMIN_RDHS
  ADMIN_RDHS
  SUPER_ADMIN_INSTITUTE
  ADMIN_INSTITUTE
  VIEWER_PDHS
  VIEWER_RDHS
  VIEWER_INSTITUTE
  STORE_KEEPER
  BIOMEDICAL_TECHNICIAN
  PROCUREMENT_OFFICER
  INSTITUTION_USER
}

enum ScopeType {
  PDHS
  RDHS
  INSTITUTE
}

// ─────────────────────────────────────────────
// HIERARCHY
// ─────────────────────────────────────────────

model District {
  id           String        @id
  name         String
  institutions Institution[]

  @@map("districts")
}

model Institution {
  id             String          @id
  name           String
  email          String?
  type           String
  active         Boolean
  districtId     String?
  district       District?       @relation(fields: [districtId], references: [id])
  users          User[]
  equipment      Equipment[]
  repairRequests RepairRequest[]
  workOrders     WorkOrder[]     @relation("InstitutionWorkOrders")
  auditLogs      AuditLog[]      @relation("InstitutionAuditLogs")

  @@map("institutions")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id                 String               @id
  username           String               @unique
  fullName           String
  email              String?              @unique
  passwordHash       String
  mustChangePassword Boolean              @default(true)
  active             Boolean              @default(true)
  institutionId      String?
  institution        Institution?         @relation(fields: [institutionId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  // Auth
  roles              UserRole[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  // App relations
  repairRequests     RepairRequest[]
  workOrders         WorkOrder[]
  auditLogs          AuditLog[]
  assignedRoles      UserRole[]           @relation("RoleAssignedBy")

  @@map("users")
}

// ─────────────────────────────────────────────
// ROLES  (many-to-many User <-> Role with scope)
// ─────────────────────────────────────────────
//
// scopeType + scopeId determines what the role applies to:
//
//   PDHS  scope  → scopeId = null        (applies to whole system)
//   RDHS  scope  → scopeId = districtId  (applies to that district)
//   INSTITUTE     → scopeId = institutionId (applies to that institution)
//
// Examples:
//   SUPER_ADMIN_PDHS  / PDHS      / null          → full system
//   ADMIN_RDHS        / RDHS      / dist_rat       → Rathnapura RDHS only
//   ADMIN_INSTITUTE   / INSTITUTE / inst_bh_rat    → Rathnapura BH only
//   BIOMEDICAL_TECHNICIAN / PDHS  / null           → PDHS-level technician
// ─────────────────────────────────────────────

model UserRole {
  id           String    @id
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         RoleType
  scopeType    ScopeType
  scopeId      String?   // districtId OR institutionId OR null — plain string, no FK
  assignedAt   DateTime  @default(now())
  assignedById String?
  assignedBy   User?     @relation("RoleAssignedBy", fields: [assignedById], references: [id])

  @@unique([userId, role, scopeId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────
// AUTH TOKENS
// ─────────────────────────────────────────────

model RefreshToken {
  id        String    @id
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// SUPPLIER
// ─────────────────────────────────────────────

model Supplier {
  id               String          @id
  name             String
  contactName      String?
  phone            String?
  email            String?
  performanceNotes String?
  rating           Int?
  purchaseOrders   PurchaseOrder[]

  @@map("suppliers")
}

// ─────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────

model InventoryItem {
  id                String     @id
  name              String
  category          String
  currentStock      Decimal    @db.Decimal(10, 2)
  minStockThreshold Decimal    @db.Decimal(10, 2)
  unitOfMeasure     String
  costPerUnit       Decimal    @db.Decimal(10, 2)
  partsUsed         PartUsed[]

  @@map("inventory_items")
}

// ─────────────────────────────────────────────
// EQUIPMENT
// ─────────────────────────────────────────────

model ServicePlan {
  id                 String    @id
  agreementReference String?
  expiryDate         DateTime? @db.Date
  noOfFreeService    Int
  servicePerAnnum    Int?
  equipmentId        String    @unique
  equipment          Equipment @relation(fields: [equipmentId], references: [id])

  // Cost details per year — stored as JSON
  // e.g. { year1: 50000, year2: 55000, year3: 60000, year4: 65000, year5: 70000 }
  serviceCosts       Json?
  labourCosts        Json?
  transportCosts     Json?
  otherCosts         Json?
  totalCosts         Json?

  // Spare parts costs as array of JSON objects
  // e.g. [{ name: 'Battery', year1: 5000, year2: 5500, ... }]
  sparePartsCosts    Json?

  @@map("service_plans")
}

model EquipmentComponent {
  id                   String    @id
  name                 String
  description          String?
  partNumber           String?
  serialNumber         String?
  quantity             Decimal   @db.Decimal(10, 2)
  componentType        String
  expiryOrWarrantyDate DateTime? @db.Date
  equipmentId          String
  equipment            Equipment @relation(fields: [equipmentId], references: [id])

  @@map("equipment_components")
}

model Equipment {
  id                    String               @id
  name                  String
  description           String?
  category              String
  manufacturer          String
  countryOfOrigin       String
  supplierName          String?
  tenderNumber          String?
  purchaseOrderNumber   String?
  modelNumber           String?
  serialNumber          String?
  batchNumber           String?
  quantityReceived      Decimal              @db.Decimal(10, 2)
  dateOfManufacture     DateTime?            @db.Date
  dateOfReceipt         DateTime?            @db.Date
  warrantyPeriodMonths  Int?
  status                String
  assignedInstitutionId String?
  assignedInstitution   Institution?         @relation(fields: [assignedInstitutionId], references: [id])
  servicePlan           ServicePlan?
  components            EquipmentComponent[]
  assignments           Assignment[]
  repairRequests        RepairRequest[]
  disposal              EquipmentDisposal?

  @@map("equipment")
}

model EquipmentDisposal {
  id                String    @id
  equipmentId       String    @unique
  disposalDate      DateTime? @db.Date
  disposalMethod    String?
  reason            String
  approvedByUserId  String
  approvalReference String?
  equipment         Equipment @relation(fields: [equipmentId], references: [id])

  @@map("equipment_disposals")
}

model Assignment {
  id             String    @id
  equipmentId    String
  equipment      Equipment @relation(fields: [equipmentId], references: [id])
  fromEntity     String
  toEntity       String
  toEntityId     String
  quantity       Decimal   @db.Decimal(10, 2)
  assignmentDate DateTime
  status         String

  @@map("assignments")
}

// ─────────────────────────────────────────────
// REPAIR
// ─────────────────────────────────────────────

model RepairRequest {
  id                    String      @id
  equipmentId           String
  equipment             Equipment   @relation(fields: [equipmentId], references: [id])
  equipmentName         String?
  equipmentSerialNumber String?
  componentId           String?
  componentName         String?
  faultDescription      String?
  priority              String
  submittedByUserId     String
  submittedByUser       User        @relation(fields: [submittedByUserId], references: [id])
  submittedByUserName   String?
  submissionDate        DateTime
  institutionId         String
  institution           Institution @relation(fields: [institutionId], references: [id])
  institutionName       String?
  workOrders            WorkOrder[]

  @@map("repair_requests")
}

model WorkOrder {
  id                     String               @id
  repairRequestId        String
  repairRequest          RepairRequest        @relation(fields: [repairRequestId], references: [id])
  assignedTechnicianId   String?
  assignedTechnician     User?                @relation(fields: [assignedTechnicianId], references: [id])
  assignedTechnicianName String?
  diagnosisNotes         String?
  status                 String
  statusDate             DateTime
  inspectedComponents    InspectedComponent[]
  partsUsed              PartUsed[]
  institutionId          String?
  institution            Institution?         @relation("InstitutionWorkOrders", fields: [institutionId], references: [id])

  @@map("work_orders")
}

model InspectedComponent {
  id             String    @id
  componentId    String
  componentName  String?
  inspected      Boolean
  conditionNotes String?
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id])

  @@map("inspected_components")
}

model PartUsed {
  id              String        @id
  description     String?
  quantity        Decimal       @db.Decimal(10, 2)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  workOrderId     String
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id])

  @@map("parts_used")
}

// ─────────────────────────────────────────────
// PROCUREMENT
// ─────────────────────────────────────────────

model ProcurementPlan {
  id                String          @id
  itemDescription   String
  estimatedQuantity Decimal         @db.Decimal(10, 2)
  estimatedCost     Decimal         @db.Decimal(10, 2)
  procurementMethod String
  purchaseOrders    PurchaseOrder[]

  @@map("procurement_plans")
}

model PurchaseOrder {
  id             String              @id
  planId         String
  plan           ProcurementPlan     @relation(fields: [planId], references: [id])
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  supplierName   String?
  poNumber       String
  orderDate      DateTime
  approvalStatus String
  totalCost      Decimal             @db.Decimal(10, 2)
  items          PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id
  description     String
  quantity        Decimal       @db.Decimal(10, 2)
  unitCost        Decimal       @db.Decimal(10, 2)
  category        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@map("purchase_order_items")
}

model Grn {
  id              String   @id
  purchaseOrderId String
  poNumber        String
  grnNumber       String
  receivedDate    DateTime
  status          String

  @@map("grns")
}

// ─────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────

model AuditLog {
  id            String       @id
  timestamp     DateTime
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  userName      String?
  userRole      String?
  action        String
  entityName    String
  recordId      String
  description   String?
  institutionId String?
  institution   Institution? @relation("InstitutionAuditLogs", fields: [institutionId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// SEED SNAPSHOT
// ─────────────────────────────────────────────

model SeedSnapshot {
  name       String   @id
  payload    Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("seed_snapshot")
}
